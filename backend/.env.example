# Backend environment variables

# Server
PORT=5000
NODE_ENV=development

# Allowed origin for CORS (your frontend URL)
FRONTEND_URL=http://localhost:5173

# Supabase PostgreSQL connection string.
# Use the connection pooler (port 6543, transaction mode) and require SSL.
# Find it in: Supabase dashboard > Project Settings > Database > Connection pooling.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Auth — used to validate frontend access tokens (auth.getClaims).
# Find these in: Supabase dashboard > Project Settings > API Keys.
# The publishable key (sb_publishable_...) is safe to use server-side here.
# Do NOT put the secret key (sb_secret_...) in this project.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>

# Cron guard — shared secret for scheduled-job endpoints. Callers must send it as
# `Authorization: Bearer <CRON_SECRET>`. Use a long random string; keep it secret.
CRON_SECRET=<your-cron-secret>

# Cloudinary — stores incident photos. Find these in: Cloudinary dashboard >
# Product Environment Settings > API Keys.
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# OpenAI — incident auto-categorisation. Not yet wired in (the service is
# currently stubbed); set this when the real OpenAI call lands.
# OPENAI_API_KEY=<your-openai-api-key>

# SMTP — Nodemailer delivery of the UC-009 monthly report email, the UC-014
# defect alerts, and the resident account-approval notice. Optional; when unset
# the underlying action still succeeds and only the email is skipped (a manager
# approving a resident is told the notice could not be sent).
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=yourapp@gmail.com
# SMTP_PASS=<your-app-password>

# Extra recipients CC'd on every defect-assignment alert (comma-separated).
# For the presentation, set this to the whole team so everyone gets the email.
# DEFECT_ALERT_RECIPIENTS=alice@example.com,bob@example.com

# Roboflow — CV defect detection workflow (UC-007).
# ROBOFLOW_API_KEY=<your-roboflow-api-key>
# ROBOFLOW_WORKFLOW_URL=https://serverless.roboflow.com/<workspace>/workflows/<workflow-id>
