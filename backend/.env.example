# Backend environment variables.
# Copy to .env and fill in the real values — .env is gitignored, this file is
# not. Never put a real credential in here.
#
# Server startup fails fast if any variable marked REQUIRED is missing (see
# src/config/env.js). The OPTIONAL ones gate a feature each: leave one unset
# and that feature degrades on its own without taking the server down.

# --- Server ---
# Both OPTIONAL — PORT defaults to 5000, NODE_ENV to development.
PORT=5000
NODE_ENV=development

# REQUIRED. Allowed origin for CORS (your frontend URL). Also used to build the
# links in outgoing emails, so it must be the URL residents actually visit.
FRONTEND_URL=http://localhost:5173

# REQUIRED. Supabase PostgreSQL connection string.
# Use the connection pooler (port 6543, transaction mode) and require SSL.
# Find it in: Supabase dashboard > Project Settings > Database > Connection pooling.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<region>.pooler.supabase.com:6543/postgres?sslmode=require

# REQUIRED. Supabase Auth — used to validate frontend access tokens
# (auth.getClaims). Find these in: Supabase dashboard > Project Settings > API Keys.
# The publishable key (sb_publishable_...) is safe to use server-side here.
# Do NOT put the secret key (sb_secret_...) in this project.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>

# OPTIONAL. Cron guard — shared secret for scheduled-job endpoints. Callers must
# send it as `Authorization: Bearer <CRON_SECRET>`. Use a long random string.
# Unset means the scheduled vendor-expiry and overdue-chase jobs cannot be
# triggered; the on-demand admin buttons still work.
CRON_SECRET=<your-cron-secret>

# REQUIRED. Cloudinary — stores incident photos. Find these in: Cloudinary
# dashboard > Product Environment Settings > API Keys.
# Note: no spaces around the "=" in your .env, to keep the file greppable.
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

# OPTIONAL. Roboflow — CV defect detection on uploaded photos (UC-007). Unset
# means photos upload and store normally, just without automatic detection.
ROBOFLOW_API_KEY=<your-roboflow-api-key>
ROBOFLOW_WORKFLOW_URL=https://serverless.roboflow.com/<workspace>/workflows/<workflow-id>

# OPTIONAL. SMTP — Nodemailer delivery of the UC-009 monthly report email, the
# UC-014 defect alerts, and the resident account-approval notice. Unset means
# the underlying action still succeeds and only the email is skipped (a manager
# approving a resident is told the notice could not be sent).
# For Gmail this must be an App Password, not your account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=yourapp@gmail.com
SMTP_PASS=<your-app-password>

# OPTIONAL. Extra recipients CC'd on every defect-assignment alert
# (comma-separated). For the presentation, set this to the whole team so
# everyone gets the email.
DEFECT_ALERT_RECIPIENTS=alice@example.com,bob@example.com

# OPTIONAL. OpenAI — auto-categorisation and priority for incoming reports, and
# the risk-alert text on the analytics dashboard. Unset falls back to a
# rules-based template rather than failing the report.
OPENAI_API_KEY=<your-openai-api-key>
