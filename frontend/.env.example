# Frontend environment variables (Vite — only VITE_* keys reach the browser).
# NEVER put secrets here: these values are baked into the public build.

# Base URL of the backend REST API.
VITE_API_URL=http://localhost:5000

# Supabase Auth (Project Settings > API Keys). Publishable key only — it is
# meant to be public. NEVER put the secret key (sb_secret_) in any VITE_* var.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<your-publishable-key>
